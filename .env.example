LLM_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-large-latest

# Or use OpenAI:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key-here

# Or use Ollama (local, no key needed):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

BUDGET_MAX_COST_USD=1.00
BUDGET_MAX_TOKENS=100000

REDIS_URL=redis://localhost:6379/0

# PostgreSQL (optional, falls back to SQLite if unset)
DATABASE_URL=postgresql://bamas:bamas_dev@localhost:5432/bamas

# Celery (defaults to REDIS_URL if unset)
# CELERY_BROKER_URL=redis://localhost:6379/1

API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change-me-in-production
